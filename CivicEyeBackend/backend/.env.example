# Database Configuration
# PostgreSQL connection URL format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://civiceye_user:your_password@localhost:5432/civiceye_db

# Session Configuration
# Secret key for signing session tokens (generate with: openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-change-in-production
SESSION_EXPIRE_SECONDS=86400  # 24 hours

# Application Settings
APP_NAME=CivicEye
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Email/SMTP Configuration (for OTP and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@civiceye.com
SMTP_FROM_NAME=CivicEye Platform

# Mock Aadhaar OTP Configuration
# In production, replace with real UIDAI API credentials
MOCK_OTP_ENABLED=True
MOCK_OTP_VALUE=123456

# AI/ML Configuration
FACE_MATCH_THRESHOLD=0.6  # Confidence threshold for face matching (0.0 to 1.0)
AI_MODEL_PATH=models/

# Penalty Configuration
DEFAULT_PENALTY_AMOUNT=500
REWARD_PERCENTAGE=10  # Percentage of penalty amount credited as reward

# Security Settings
# IMPORTANT: In production, set these appropriately
COOKIE_SECURE=False  # Set to True in production (requires HTTPS)
COOKIE_SAMESITE=Lax  # Use 'Strict' or 'Lax' in production

# Aadhaar Security Notes:
# - Never store raw Aadhaar biometric data
# - Only store masked Aadhaar numbers (XXXX-XXXX-1234 format)
# - Use official UIDAI APIs in production with proper authentication
# - Ensure compliance with Aadhaar Act and IT Act regulations
