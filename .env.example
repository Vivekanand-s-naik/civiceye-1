# ==============================================================================
# CivicEye - Unified Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables to match your local setup:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/CivicEyeDB
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGHOST=localhost
PGPORT=5432
PGDATABASE=CivicEyeDB

# ------------------------------------------------------------------------------
# 2. Server & Network Ports
# ------------------------------------------------------------------------------
PORT=3000
BACKEND_PORT=5000
FRONTEND_PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_NAME=CivicEye
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Sessions
# ------------------------------------------------------------------------------
SECRET_KEY=generate-a-strong-random-32-byte-secret-key
SESSION_SECRET=generate-a-strong-random-32-byte-secret-key
SESSION_EXPIRE_SECONDS=86400
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# ------------------------------------------------------------------------------
# 4. File Upload Configuration
# ------------------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 5. Email & SMTP Configuration (OTP, Notifications, Alerts)
# ------------------------------------------------------------------------------
CIVICEYE_EMAIL=your_email@gmail.com
CIVICEYE_APP_PASSWORD=your_gmail_app_password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=CivicEye Platform

# ------------------------------------------------------------------------------
# 6. Aadhaar Verification (Mock for local development)
# ------------------------------------------------------------------------------
MOCK_OTP_ENABLED=True
MOCK_OTP_VALUE=123456

# ------------------------------------------------------------------------------
# 7. AI & Machine Learning Configuration
# ------------------------------------------------------------------------------
FACE_MATCH_THRESHOLD=0.6
AI_MODEL_PATH=models/
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 8. Penalties & Rewards Governance Rules
# ------------------------------------------------------------------------------
DEFAULT_PENALTY_AMOUNT=500
REWARD_PERCENTAGE=10

